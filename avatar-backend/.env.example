BASE_URL="https://apis.iflow.cn/v1"
API_KEY=""

# TTS_PROVIDER 默认仍然使用 qwen，确保不新增任何配置时旧功能保持不变。
# 可选值：qwen / aliyun
TTS_PROVIDER="qwen"

# ==============================
# 阿里云 TTS 可选配置（仅当 TTS_PROVIDER=aliyun 时生效）
# ==============================
# 阿里云智能语音交互 REST TTS 服务地址。
ALIYUN_TTS_URL="https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts"

# 阿里云语音合成 AppKey。
ALIYUN_TTS_APP_KEY=""

# 阿里云语音合成 Token。
ALIYUN_TTS_TOKEN=""

# 发音人，可按业务需要替换为阿里云支持的 voice。
ALIYUN_TTS_VOICE="xiaoyun"

ALIYUN_TTS_FORMAT="wav"

# 采样率建议与口型模型输入保持一致。
ALIYUN_TTS_SAMPLE_RATE="16000"

# 语速、语调、音量均保持阿里云默认中性值，可按需调整。
ALIYUN_TTS_SPEECH_RATE="0"
ALIYUN_TTS_PITCH_RATE="0"
ALIYUN_TTS_VOLUME="50"

# 阿里云 TTS 请求超时，单位秒。
ALIYUN_TTS_TIMEOUT="60"