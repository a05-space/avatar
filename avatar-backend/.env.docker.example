# Docker 构建阶段镜像源
APT_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=

# 如需安装 flash-attn 预编译 wheel，可填入国内可访问的直链；留空则跳过。
FLASH_ATTN_WHEEL_URL=

# 服务端口
PORT=8109
HOST_PORT=8210

# 模型下载镜像
HF_ENDPOINT=https://hf-mirror.com

# LLM 接口
BASE_URL=https://apis.iflow.cn/v1
API_KEY=

# TTS provider
# qwen: 使用本地 Qwen3-TTS 模型
# aliyun: 使用阿里云在线 TTS
TTS_PROVIDER=aliyun

# 阿里云 TTS 配置（TTS_PROVIDER=aliyun 时生效）
ALIYUN_TTS_URL=https://nls-gateway-cn-shanghai.aliyuncs.com/stream/v1/tts
ALIYUN_TTS_APP_KEY=
ALIYUN_TTS_TOKEN=
ALIYUN_TTS_VOICE=xiaoyun
ALIYUN_TTS_FORMAT=wav
ALIYUN_TTS_SAMPLE_RATE=16000
ALIYUN_TTS_SPEECH_RATE=0
ALIYUN_TTS_PITCH_RATE=0
ALIYUN_TTS_VOLUME=50
ALIYUN_TTS_TIMEOUT=60

# NVIDIA 容器运行时
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility
